# Public application configuration
PUBLIC_BASE_URL=https://app.example.com
APP_ORIGINS=https://app.example.com

# Required security secrets (generate independent random values of at least 32 bytes)
EXTERNAL_EFFECTS_ENABLED=false
OAUTH_STATE_SECRET=
CRON_SECRET=
UNSUB_SECRET=
TWILIO_AUTH_TOKEN=

# Supabase browser authentication (required at Vite build time)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase server authentication
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# SUPABASE_SERVICE_ROLE_KEY may be used instead of SUPABASE_SERVICE_KEY.

# Existing integration configuration
RESEND_API_KEY=
OPENAI_API_KEY=
MLSGRID_BASE=
MLSGRID_TOKEN=
MICROSOFT_SYSTEM_TENANT_ID=
MICROSOFT_SYSTEM_CLIENT_ID=
MICROSOFT_SYSTEM_CLIENT_SECRET=
MICROSOFT_SYSTEM_MAILBOX=
